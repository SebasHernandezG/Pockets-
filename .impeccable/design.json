  "narrative": {
    "northStar": "Interfaz sencilla aprobada",
    "overview": "La dirección aprobada es sencilla y moderna: fondo claro cálido, superficies blancas y verde profundo. La interfaz se construye directamente en código; la implementación existente es la autoridad visual.\n\nLa densidad permite registrar un gasto y entender el saldo desde el celular. Las categorías se leen como filas de una hoja de gastos; el color acompaña nombres, cantidades y una leyenda.",
    "keyCharacteristics": [
      "Fondo cálido, blanco y verde profundo.",
      "Filas legibles y cifras tabulares.",
      "Navegación y controles adaptados al celular."
    ],
    "rules": [
      {
        "name": "The Category Context Rule",
        "body": "Cada color de categoría se presenta con texto o una leyenda; las cantidades siguen disponibles en la lista.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do conservar el fondo cálido, las superficies blancas y el verde profundo aprobados.",
      "Do acompañar el color de categoría con nombre y cantidad.",
      "Do mantener el foco visible, los controles táctiles y el movimiento reducido.",
      "Do reflejar los estados vacíos y negativos con texto explícito."
    ],
    "donts": [
      "Don't cambiar la identidad aprobada al agregar pantallas.",
      "Don't introducir datos ficticios en estados vacíos.",
      "Don't depender únicamente del color para explicar gastos o saldo."
    ]
  }
